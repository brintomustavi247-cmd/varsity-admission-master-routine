{
  "folders": [
    {
      "name": "Admission Master Routine",
      "path": "."
    }
  ],
  "settings": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "css.lint.unknownAtRules": "ignore",
    "files.associations": {
      "*.css": "tailwindcss"
    },
    "tailwindCSS.includeLanguages": {
      "typescriptreact": "html",
      "typescript": "html"
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.aistudio": true
    },
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#16206E",
      "titleBar.activeForeground": "#E0F2FE",
      "titleBar.inactiveBackground": "#111954",
      "titleBar.inactiveForeground": "#93C5FD",
      "activityBar.background": "#111954",
      "activityBar.foreground": "#38BDF8",
      "activityBar.activeBorder": "#38BDF8",
      "activityBarBadge.background": "#4F46E5",
      "activityBarBadge.foreground": "#FFFFFF",
      "statusBar.background": "#1D2B8F",
      "statusBar.foreground": "#E0F2FE",
      "statusBar.debuggingBackground": "#0284C7",
      "statusBar.noFolderBackground": "#16206E",
      "tab.activeBorderTop": "#38BDF8"
    }
  },
  "extensions": {
    "recommendations": [
      "bradlc.vscode-tailwindcss",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "firebase.vscode-firebase-explorer"
    ]
  }
}

<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ভার্সিটি অ্যাডমিশন মাস্টার রুটিন ২০২৬-২৭</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎓</text></svg>">
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700;800&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
<script>
try {
  const saved = JSON.parse(localStorage.getItem('admission_revised_v3'));
  if (saved && saved.settings && saved.settings.theme === 'dark') {
    document.documentElement.setAttribute('data-theme', 'dark');
  }
} catch (e) {}
</script>
<style>
:root{
  color-scheme: light;
  --bg:#F8FAFC;
  --card:#FFFFFF;
  --text:#0F172A;
  --muted:#64748B;
  --border:#E2E8F0;
  --primary:#4F46E5;
  --primary-soft:#EEF2FF;
  --success:#059669;
  --success-soft:#D1FAE5;
  --warning:#D97706;
  --warning-soft:#FEF3C7;
  --info:#0284C7;
  --info-soft:#E0F2FE;
  --purple:#7E22CE;
  --purple-soft:#F3E8FF;
  --shadow:0 8px 24px rgba(15,23,42,.06);
}
html[data-theme="dark"]{
  color-scheme: dark;
  --bg:#0B1120;
  --card:#111827;
  --text:#F9FAFB;
  --muted:#9CA3AF;
  --border:#1F2937;
  --primary:#818CF8;
  --primary-soft:rgba(129,140,248,.12);
  --success:#34D399;
  --success-soft:rgba(52,211,153,.12);
  --warning:#FBBF24;
  --warning-soft:rgba(251,191,36,.12);
  --info:#38BDF8;
  --info-soft:rgba(56,189,248,.12);
  --purple:#C084FC;
  --purple-soft:rgba(192,132,252,.12);
  --shadow:0 8px 24px rgba(0,0,0,.35);
}
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:'Hind Siliguri',sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.6;
  min-height:100vh;
}
.container{max-width:980px;margin:0 auto;padding:16px}
.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:20px;
  box-shadow:var(--shadow);
}
.hero{
  padding:22px;
  display:flex;
  justify-content:space-between;
  gap:14px;
  align-items:center;
  margin-bottom:14px;
}
.hero h1{
  font-size:26px;
  font-weight:800;
  line-height:1.35;
}
.hero p{color:var(--muted);font-size:14px;margin-top:4px}
.theme-btn{
  border:1px solid var(--border);
  background:var(--bg);
  color:var(--text);
  border-radius:14px;
  padding:10px 14px;
  cursor:pointer;
  font-family:inherit;
  font-weight:700;
  white-space:nowrap;
}
.stats{
  padding:18px;
  margin-bottom:14px;
}
.stats-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}
.stat-box{
  background:var(--bg);
  border:1px solid var(--border);
  border-radius:16px;
  padding:14px 10px;
  text-align:center;
}
.stat-value{
  font-family:'Inter',sans-serif;
  font-size:24px;
  font-weight:800;
  color:var(--primary);
}
.stat-label{
  color:var(--muted);
  font-size:12px;
  font-weight:700;
  margin-top:4px;
}
.progress-bar{
  height:10px;
  border-radius:999px;
  background:var(--border);
  overflow:hidden;
  margin-top:14px;
}
.progress-fill{
  height:100%;
  width:0%;
  border-radius:999px;
  background:linear-gradient(90deg,var(--primary),#22C55E);
  transition:width .35s ease;
}
.tabs{
  display:flex;
  gap:8px;
  padding:8px;
  margin-bottom:14px;
  overflow-x:auto;
}
.tab-btn{
  flex:1;
  min-width:max-content;
  border:none;
  background:transparent;
  color:var(--muted);
  padding:12px 16px;
  border-radius:14px;
  font-family:inherit;
  font-size:15px;
  font-weight:700;
  cursor:pointer;
}
.tab-btn.active{
  background:var(--primary);
  color:#fff;
  box-shadow:0 8px 18px rgba(79,70,229,.22);
}
.toolbar{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:14px;
}
.search-box{
  flex:1;
  min-width:220px;
  border:1px solid var(--border);
  background:var(--card);
  color:var(--text);
  border-radius:14px;
  padding:12px 14px;
  font-family:inherit;
  outline:none;
}
.search-box:focus{border-color:var(--primary)}
.action-btn{
  border:1px solid var(--border);
  background:var(--card);
  color:var(--text);
  border-radius:14px;
  padding:12px 14px;
  cursor:pointer;
  font-family:inherit;
  font-weight:700;
}
.action-btn.danger{color:#DC2626;border-color:rgba(220,38,38,.25)}
.tab-content{display:none}
.tab-content.active{display:block;animation:fade .25s ease}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.phase-header{
  margin:18px 0 12px;
  padding:12px 16px;
  border-radius:16px;
  background:var(--primary-soft);
  color:var(--primary);
  font-weight:800;
  border:1px solid rgba(79,70,229,.08);
}
.day-card{
  padding:16px;
  margin-bottom:12px;
  border-left:5px solid var(--primary);
}
.day-card.test{border-left-color:#F59E0B}
.day-card.buffer,.day-card.solve{border-left-color:#38BDF8}
.day-card.revision,.day-card.final{border-left-color:#10B981}
.day-card.model{border-left-color:#A855F7}
.day-card.completed{opacity:.78}
.day-card.today{outline:2px solid var(--primary);outline-offset:2px}
.day-head{
  display:flex;
  justify-content:space-between;
  gap:10px;
  align-items:center;
  flex-wrap:wrap;
  margin-bottom:12px;
}
.day-meta{
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
}
.day-badge{
  padding:5px 10px;
  border-radius:999px;
  font-size:12px;
  font-weight:800;
  font-family:'Inter',sans-serif;
}
.badge-normal{background:var(--primary-soft);color:var(--primary)}
.badge-test{background:var(--warning-soft);color:var(--warning)}
.badge-buffer,.badge-solve{background:var(--info-soft);color:var(--info)}
.badge-revision,.badge-final{background:var(--success-soft);color:var(--success)}
.badge-model{background:var(--purple-soft);color:var(--purple)}
.day-date{font-weight:800}
.type-label{
  color:var(--muted);
  font-size:13px;
  font-weight:700;
}
.today-badge{
  background:var(--success-soft);
  color:var(--success);
  padding:4px 10px;
  border-radius:999px;
  font-size:12px;
  font-weight:800;
}
.task-row{
  display:flex;
  gap:12px;
  align-items:flex-start;
  padding:10px 0;
  border-top:1px dashed var(--border);
}
.task-row:first-of-type{border-top:none}
.task-icon{font-size:18px;margin-top:3px}
.task-content{flex:1}
.task-title{
  font-size:11px;
  letter-spacing:.6px;
  font-weight:800;
  color:var(--muted);
  text-transform:uppercase;
  margin-bottom:3px;
}
.task-desc{font-weight:600}
.task-row.completed .task-desc{
  text-decoration:line-through;
  color:var(--muted);
}
.check-box{
  width:30px;
  height:30px;
  border-radius:10px;
  border:2px solid var(--border);
  background:var(--bg);
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  transition:.18s ease;
}
.check-box:hover{transform:scale(1.05);border-color:var(--primary)}
.check-box.checked{
  background:var(--success);
  border-color:var(--success);
}
.check-box.checked::after{
  content:"✓";
  color:#fff;
  font-weight:900;
}
.subject-card{margin-bottom:14px;overflow:hidden}
.subject-head{
  padding:16px;
  display:flex;
  justify-content:space-between;
  gap:10px;
  align-items:center;
  cursor:pointer;
}
.subject-title{font-size:18px;font-weight:800}
.subject-progress{
  font-family:'Inter',sans-serif;
  font-weight:800;
  color:var(--primary);
}
.subject-body{padding:16px;border-top:1px solid var(--border)}
.chap-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:10px;
}
@media(min-width:760px){.chap-grid{grid-template-columns:1fr 1fr}}
.chap-item{
  background:var(--bg);
  border:1px solid var(--border);
  border-radius:16px;
  padding:14px;
}
.chap-name{font-weight:700;margin-bottom:10px}
.chap-actions{display:flex;gap:6px;flex-wrap:wrap}
.mini-check{
  border:1px solid var(--border);
  background:var(--card);
  color:var(--muted);
  padding:6px 10px;
  border-radius:10px;
  font-family:inherit;
  font-size:12px;
  font-weight:800;
  cursor:pointer;
}
.mini-check.active{
  background:var(--success);
  border-color:var(--success);
  color:#fff;
}
.info-card{padding:18px;margin-bottom:14px}
.info-card h3{
  font-size:18px;
  margin-bottom:10px;
  color:var(--primary);
}
.info-card ul{padding-left:20px;color:var(--muted)}
.info-card li{margin-bottom:8px}
.info-card strong{color:var(--text)}
.hidden{display:none!important}
.empty-msg{
  padding:30px;
  text-align:center;
  color:var(--muted);
}
@media(max-width:640px){
  .hero{flex-direction:column;align-items:flex-start}
  .stats-grid{grid-template-columns:1fr 1fr 1fr}
  .stat-value{font-size:20px}
}
</style>
</head>
<body>
<div class="container">

  <header class="hero card">
    <div>
      <h1>🎓 ভার্সিটি অ্যাডমিশন মাস্টার রুটিন</h1>
      <p>Revised • ১৬ নভেম্বর ২০২৬ – ১৫ জানুয়ারি ২০২৭ • ৬১ দিন • বিজ্ঞান ইউনিট</p>
    </div>
    <button class="theme-btn" id="themeBtn" onclick="toggleTheme()">🌙 Dark Mode</button>
  </header>

  <section class="stats card">
    <div class="stats-grid">
      <div class="stat-box">
        <div class="stat-value" id="daysDone">0/61</div>
        <div class="stat-label">দিন সম্পন্ন</div>
      </div>
      <div class="stat-box">
        <div class="stat-value" id="chapsDone">0/51</div>
        <div class="stat-label">অধ্যায় সম্পন্ন</div>
      </div>
      <div class="stat-box">
        <div class="stat-value" id="overallPct">0%</div>
        <div class="stat-label">সামগ্রিক</div>
      </div>
    </div>
    <div class="progress-bar">
      <div class="progress-fill" id="overallBar"></div>
    </div>
  </section>

  <nav class="tabs card">
    <button class="tab-btn active" onclick="switchTab(event,'routine')">📅 রুটিন</button>
    <button class="tab-btn" onclick="switchTab(event,'syllabus')">📚 সিলেবাস ট্র্যাকার</button>
    <button class="tab-btn" onclick="switchTab(event,'strategy')">🧠 কৌশল</button>
  </nav>

  <div class="toolbar">
    <input class="search-box" id="searchInput" placeholder="🔍 অধ্যায় / টপিক সার্চ করুন..." oninput="renderRoutine(this.value)">
    <button class="action-btn" onclick="exportData()">📥 Backup</button>
    <button class="action-btn" onclick="document.getElementById('importFile').click()">📤 Import</button>
    <input type="file" id="importFile" accept=".json" style="display:none" onchange="importData(event)">
    <button class="action-btn danger" onclick="resetData()">🗑️ Reset</button>
  </div>

  <main>
    <section id="routine" class="tab-content active">
      <div id="routine-list"></div>
    </section>

    <section id="syllabus" class="tab-content">
      <div id="syllabus-list"></div>
    </section>

    <section id="strategy" class="tab-content">
      <div class="info-card card">
        <h3>⏱️ দৈনিক সময়বণ্টন (প্রায় ৮ ঘণ্টা)</h3>
        <ul>
          <li><strong>সকাল/দুপুর (৩ ঘণ্টা):</strong> নির্ধারিত অধ্যায়ের থিওরি, সূত্র ও কনসেপ্ট কুইক রিভিশন।</li>
          <li><strong>বিকাল (৩.৫ ঘণ্টা):</strong> বিগত বছরের ব্যাংক (RU, CU, GST, JU, DU) হাতে-কলমে সলভ। ভুল/কঠিন প্রশ্ন লাল কলমে মার্ক করো।</li>
          <li><strong>রাত (১ ঘণ্টা):</strong> ইংরেজির নির্ধারিত টপিক অনুশীলন।</li>
          <li><strong>রাত (৩০ মিনিট):</strong> স্পেসড রিভিশন — আগের দিন + ১ সপ্তাহ আগের অধ্যায়।</li>
        </ul>
      </div>

      <div class="info-card card">
        <h3>📌 কীভাবে চলবে</h3>
        <ul>
          <li><strong>১ দিন পিছিয়ে পড়লে:</strong> পরের শুক্রবারের কাভার-আপ সেটে পূরণ করো।</li>
          <li><strong>২ দিনের বেশি পিছালে:</strong> হালকা অধ্যায়গুলোর ব্যাংক ছোট করো (পরিবেশ, অর্থনৈতিক, কো-অর্ডিনেশন, জ্যোতির্বিজ্ঞান, সেমিকন্ডাক্টর, রৈখিক প্রোগ্রামিং, বিস্তার পরিমাপ)।</li>
          <li><strong>ভারী অধ্যায় কখনো বাদ দেবে না।</strong></li>
          <li><strong>ভুলের খাতা:</strong> প্রতিদিনের ভুল প্রশ্ন সংক্ষেপে লিখবে। শুক্রবার ও মডেল টেস্টের পর এখান থেকেই রিভিশন হবে।</li>
          <li><strong>সাপ্তাহিক টেস্ট:</strong> প্রতি শুক্রবার সকালে ঐ সপ্তাহের অধ্যায়গুলো থেকে ২ ঘণ্টার মিক্সড টেস্ট দাও।</li>
        </ul>
      </div>

      <div class="info-card card">
        <h3>💾 Save / Backup</h3>
        <ul>
          <li>টিক দিলেই অটোমেটিক এই ব্রাউজারের <strong>LocalStorage</strong>-এ সেভ হবে।</li>
          <li>ব্রাউজার ডাটা ক্লিন করলে মুছে যেতে পারে, তাই মাঝে মাঝে <strong>Backup</strong> নিয়ে রাখো।</li>
          <li>ডিভাইস/ব্রাউজার পরিবর্তন করলে <strong>Import</strong> করে ব্যাকআপ ফিরিয়ে আনতে পারবে।</li>
        </ul>
      </div>
    </section>
  </main>
</div>

<script>
const STORAGE_KEY = 'admission_revised_v3';

let state = {
  routine: {},
  syllabus: {},
  settings: { theme: 'light' }
};

try {
  const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
  if (saved) {
    state = {
      ...state,
      ...saved,
      settings: { ...state.settings, ...(saved.settings || {}) }
    };
  }
} catch (e) {}

const routineData = [
  {d:1, iso:"2026-11-16", date:"১৬ নভেম্বর", main:"ত্রিকোণমিতিক অনুপাত + ভৌতজগৎ ও পরিমাপ (দুই অধ্যায়)", eng:"Parts of Speech & Noun", rev:"আজকের অধ্যায়ের সূত্র একবার লিখে ফেলা", type:"normal"},
  {d:2, iso:"2026-11-17", date:"১৭ নভেম্বর", main:"সংযুক্ত কোণের ত্রিকোণমিতি + ল্যাবরেটরির নিরাপদ ব্যবহার (দুই অধ্যায়)", eng:"Pronoun & Determiners", rev:"আগের দিন: ত্রিকোণমিতিক অনুপাত + ভৌতজগৎ ও পরিমাপ", type:"normal"},
  {d:3, iso:"2026-11-18", date:"১৮ নভেম্বর", main:"গুণগত রসায়ন-১ (পরমাণু মডেল, কোয়ান্টাম সংখ্যা)", eng:"Articles & Tag Questions", rev:"আগের দিন: সংযুক্ত কোণ + ল্যাবরেটরি", type:"normal"},
  {d:4, iso:"2026-11-19", date:"১৯ নভেম্বর", main:"গুণগত রসায়ন-২ (দ্রাব্যতা ও আয়ন শনাক্তকরণ)", eng:"Right Form of Verbs (Rule 1–15)", rev:"আগের দিন: গুণগত রসায়ন-১", type:"normal"},
  {d:5, iso:"2026-11-20", date:"২০ নভেম্বর", main:"সাপ্তাহিক টেস্ট + কাভার-আপ দিন (২ ঘণ্টা টেস্ট → ২ ঘণ্টা ভুল বিশ্লেষণ → ২ ঘণ্টা ব্যাকলগ)", eng:"সম্পূর্ণ সপ্তাহের রিভিশন", rev:"ভুলের খাতা আপডেট ও বিশ্রাম", type:"test"},
  {d:6, iso:"2026-11-21", date:"২১ নভেম্বর", main:"ফাংশন ও ফাংশনের লেখচিত্র", eng:"Right Form of Verbs (Rule 16–30)", rev:"আগের দিন: গুণগত রসায়ন-২", type:"normal"},

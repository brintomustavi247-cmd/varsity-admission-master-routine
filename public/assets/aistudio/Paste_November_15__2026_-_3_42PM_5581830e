let subjectRanges = [];
const todayISO = new Date().toLocaleDateString('en-CA');

function saveState() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  } catch (e) {}
  updateStats();
}

function getWeekday(iso) {
  const bn = ["রবি","সোম","মঙ্গল","বুধ","বৃহ","শুক্র","শনি"];
  const d = new Date(iso + "T00:00:00");
  return bn[d.getDay()];
}

function getPhase(d) {
  if (d <= 12) return "ধাপ ১ • সপ্তাহ ১–২ (১৬–২৭ নভেম্বর)";
  if (d <= 26) return "ধাপ ১ • সপ্তাহ ৩–৪ (২৮ নভেম্বর–১১ ডিসেম্বর)";
  if (d <= 40) return "ধাপ ১ • সপ্তাহ ৫–৬ (১২–২৫ ডিসেম্বর)";
  if (d <= 48) return "ধাপ ১ • সপ্তাহ ৭–৮ (২৬ ডিসেম্বর–২ জানুয়ারি)";
  return "ধাপ ২ • ফাইনাল রিভিশন ও মডেল টেস্ট (৩–১৫ জানুয়ারি)";
}

function typeMeta(type) {
  const map = {
    normal: {label:"রেগুলার", badge:"badge-normal", cls:"normal"},
    test: {label:"সাপ্তাহিক টেস্ট", badge:"badge-test", cls:"test"},
    buffer: {label:"বাফার", badge:"badge-buffer", cls:"buffer"},
    revision: {label:"ফাইনাল রিভিশন", badge:"badge-revision", cls:"revision"},
    solve: {label:"ইউনিভার্সিটি সলভ", badge:"badge-solve", cls:"solve"},
    model: {label:"মডেল টেস্ট", badge:"badge-model", cls:"model"},
    final: {label:"ফাইনাল ডে", badge:"badge-final", cls:"final"}
  };
  return map[type] || map.normal;
}

function renderRoutine(filter = "") {
  const list = document.getElementById("routine-list");
  list.innerHTML = "";
  const q = filter.trim().toLowerCase();
  const data = q
    ? routineData.filter(item =>
        (item.main + item.eng + item.rev + item.date).toLowerCase().includes(q)
      )
    : routineData;

  if (!data.length) {
    list.innerHTML = `<div class="card empty-msg">কোনো রুটিন খুঁজে পাওয়া যায়নি।</div>`;
    return;
  }

  let lastPhase = "";
  data.forEach(day => {
    if (!q) {
      const phase = getPhase(day.d);
      if (phase !== lastPhase) {
        list.insertAdjacentHTML("beforeend", `<div class="phase-header">${phase}</div>`);
        lastPhase = phase;
      }
    }

    const s = state.routine[day.d] || {main:false, eng:false, rev:false};
    const allDone = s.main && s.eng && s.rev;
    const meta = typeMeta(day.type);
    const isToday = day.iso === todayISO;

    list.insertAdjacentHTML("beforeend", `
      <article class="day-card card ${meta.cls} ${allDone ? "completed" : ""} ${isToday ? "today" : ""}">
        <div class="day-head">
          <div class="day-meta">
            <span class="day-badge ${meta.badge}">Day ${String(day.d).padStart(2,"0")}</span>
            <span class="day-date">${day.date}, ${getWeekday(day.iso)}</span>
            ${isToday ? `<span class="today-badge">আজ</span>` : ""}
          </div>
          <div class="type-label">${meta.label}</div>
        </div>

        <div class="task-row ${s.main ? "completed" : ""}">
          <div class="task-icon">📌</div>
          <div class="task-content">
            <div class="task-title">মূল অধ্যায়</div>
            <div class="task-desc">${day.main}</div>
          </div>
          <button class="check-box ${s.main ? "checked" : ""}" aria-label="মূল অধ্যায় সম্পন্ন" onclick="toggleTask(${day.d}, 'main', this)"></button>
        </div>

        <div class="task-row ${s.eng ? "completed" : ""}">
          <div class="task-icon">🇬🇧</div>
          <div class="task-content">
            <div class="task-title">ইংরেজি (রাত ১ ঘণ্টা)</div>
            <div class="task-desc">${day.eng}</div>
          </div>
          <button class="check-box ${s.eng ? "checked" : ""}" aria-label="ইংরেজি সম্পন্ন" onclick="toggleTask(${day.d}, 'eng', this)"></button>
        </div>

        <div class="task-row ${s.rev ? "completed" : ""}">
          <div class="task-icon">🔄</div>
          <div class="task-content">
            <div class="task-title">স্পেসড রিভিশন (৩০ মিনিট)</div>
            <div class="task-desc">${day.rev}</div>
          </div>
          <button class="check-box ${s.rev ? "checked" : ""}" aria-label="রিভিশন সম্পন্ন" onclick="toggleTask(${day.d}, 'rev', this)"></button>
        </div>
      </article>
    `);
  });
}

function renderSyllabus() {
  const list = document.getElementById("syllabus-list");
  list.innerHTML = "";
  subjectRanges = [];
  let chapIndex = 0;
  let subjectIndex = 0;

  Object.entries(syllabusData).forEach(([subject, chapters]) => {
    const start = chapIndex;
    let subjectDone = 0;
    let chapHTML = "";

    chapters.forEach(chap => {
      const key = "chap_" + chapIndex;
      const s = state.syllabus[key] || {t:false,b:false,r1:false,r2:false};
      if (s.t) subjectDone++;
      if (s.b) subjectDone++;
      if (s.r1) subjectDone++;
      if (s.r2) subjectDone++;

      chapHTML += `
        <div class="chap-item">
          <div class="chap-name">${chap}</div>
          <div class="chap-actions">
            <button class="mini-check ${s.t ? "active" : ""}" data-key="${key}" data-step="t">থিওরি</button>
            <button class="mini-check ${s.b ? "active" : ""}" data-key="${key}" data-step="b">ব্যাংক</button>
            <button class="mini-check ${s.r1 ? "active" : ""}" data-key="${key}" data-step="r1">রিভিশন ১</button>
            <button class="mini-check ${s.r2 ? "active" : ""}" data-key="${key}" data-step="r2">রিভিশন ২</button>
          </div>
        </div>
      `;
      chapIndex++;
    });

    subjectRanges.push({start, count: chapters.length});
    const pct = Math.round((subjectDone / (chapters.length * 4)) * 100);

    list.insertAdjacentHTML("beforeend", `
      <div class="subject-card card">
        <div class="subject-head" onclick="this.parentElement.querySelector('.subject-body').classList.toggle('hidden')">
          <div class="subject-title">📖 ${subject}</div>
          <div class="subject-progress" id="subject-progress-${subjectIndex}">${pct}%</div>
        </div>
        <div class="progress-bar"><div class="progress-fill" id="subject-bar-${subjectIndex}" style="width:${pct}%"></div></div>
        <div class="subject-body">
          <div class="chap-grid">${chapHTML}</div>
        </div>
      </div>
    `);
    subjectIndex++;
  });

  list.querySelectorAll(".mini-check").forEach(btn => {
    btn.addEventListener("click", () => {
      toggleChap(btn.dataset.key, btn.dataset.step, btn);
    });
  });
}

function toggleTask(dayId, task, btn) {
  if (!state.routine[dayId]) state.routine[dayId] = {main:false, eng:false, rev:false};
  state.routine[dayId][task] = !state.routine[dayId][task];

  btn.classList.toggle("checked");
  const row = btn.closest(".task-row");
  row.classList.toggle("completed");

  const card = btn.closest(".day-card");
  const s = state.routine[dayId];
  card.classList.toggle("completed", Boolean(s.main && s.eng && s.rev));

  saveState();
}

function toggleChap(key, step, btn) {
  if (!state.syllabus[key]) state.syllabus[key] = {t:false,b:false,r1:false,r2:false};
  state.syllabus[key][step] = !state.syllabus[key][step];
  btn.classList.toggle("active");
  saveState();
  updateSubjectProgress();
}

function updateSubjectProgress() {
  subjectRanges.forEach((range, idx) => {
    let done = 0;
    for (let i = range.start; i < range.start + range.count; i++) {
      const s = state.syllabus["chap_" + i];
      if (s) {
        if (s.t) done++;
        if (s.b) done++;
        if (s.r1) done++;
        if (s.r2) done++;
      }
    }
    const pct = Math.round((done / (range.count * 4)) * 100);
    const bar = document.getElementById("subject-bar-" + idx);
    const label = document.getElementById("subject-progress-" + idx);
    if (bar) bar.style.width = pct + "%";
    if (label) label.textContent = pct + "%";
  });
}

function updateStats() {
  let daysDone = 0;
  routineData.forEach(day => {
    const s = state.routine[day.d];
    if (s && s.main && s.eng && s.rev) daysDone++;
  });

  let totalChapters = 0;
  Object.values(syllabusData).forEach(arr => totalChapters += arr.length);

  let chaptersDone = 0;
  for (let i = 0; i < totalChapters; i++) {
    const s = state.syllabus["chap_" + i];
    if (s && s.t && s.b && s.r1 && s.r2) chaptersDone++;
  }

  let doneTasks = 0;
  Object.values(state.routine).forEach(s => {
    if (s.main) doneTasks++;
    if (s.eng) doneTasks++;
    if (s.rev) doneTasks++;
  });
  Object.values(state.syllabus).forEach(s => {
    if (s.t) doneTasks++;
    if (s.b) doneTasks++;
    if (s.r1) doneTasks++;
    if (s.r2) doneTasks++;
  });

  const totalTasks = (routineData.length * 3) + (totalChapters * 4);
  const pct = Math.round((doneTasks / totalTasks) * 100);

  document.getElementById("daysDone").textContent = daysDone + "/61";
  document.getElementById("chapsDone").textContent = chaptersDone + "/" + totalChapters;
  document.getElementById("overallPct").textContent = pct + "%";
  document.getElementById("overallBar").style.width = pct + "%";
}

function switchTab(evt, tabId) {
  document.querySelectorAll(".tab-content").forEach(el => el.classList.remove("active"));
  document.querySelectorAll(".tab-btn").forEach(el => el.classList.remove("active"));
  document.getElementById(tabId).classList.add("active");
  evt.currentTarget.classList.add("active");
}

function applyTheme() {
  const dark = state.settings.theme === "dark";
  if (dark) document.documentElement.setAttribute("data-theme", "dark");
  else document.documentElement.removeAttribute("data-theme");

  const btn = document.getElementById("themeBtn");
  if (btn) btn.innerHTML = dark ? "☀️ Light Mode" : "🌙 Dark Mode";
}

function toggleTheme() {
  state.settings.theme = state.settings.theme === "dark" ? "light" : "dark";
  saveState();
  applyTheme();
}

function renderAll() {
  const q = document.getElementById("searchInput") ? document.getElementById("searchInput").value : "";
  renderRoutine(q);
  renderSyllabus();
  updateStats();
}

function exportData() {
  const blob = new Blob([JSON.stringify(state, null, 2)], {type:"application/json"});
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "admission-routine-backup.json";
  a.click();
  URL.revokeObjectURL(a.href);
}

function importData(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const parsed = JSON.parse(e.target.result);
      if (parsed && typeof parsed === "object") {
        state = {
          routine: parsed.routine || {},
          syllabus: parsed.syllabus || {},
          settings: { theme: (parsed.settings && parsed.settings.theme) || "light" }
        };
        saveState();
        applyTheme();
        renderAll();
        alert("ডাটা সফলভাবে ইমপোর্ট হয়েছে ✅");
      }
    } catch (err) {
      alert("দুঃখিত, ফাইলটি সঠিক JSON নয় ❌");
    }
  };
  reader.readAsText(file);
  event.target.value = "";
}

function resetData() {
  if (!confirm("সব টিক/প্রগ্রেস মুছে যাবে। আপনি কি নিশ্চিত?")) return;
  state = {
    routine: {},
    syllabus: {},
    settings: { theme: state.settings.theme }
  };
  saveState();
  renderAll();
}

document.addEventListener("DOMContentLoaded", () => {
  applyTheme();
  renderAll();
});
</script>
</body>

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|mascot/|sw.js|favicon.ico|manifest.webmanifest|manifest.json).*)",
      "destination": "/index.html"
    }
  ]
}
